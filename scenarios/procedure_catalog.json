      "found=false 时绝对不能投喂。",
      "找到后由 pet_tracking.find 完成五秒录像并生成App上传清单，随后才允许进入投喂步骤。",
      "投食机Token过期、设备离线、网络或接口失败不得影响已经完成的寻找、录像和App上传；失败时按结构化原因明确说明未投喂。"
      ],
      "steps": [
        {
          "id": "navigate",
          "skill": "navigation_goto",
          "action": "goto",
          "arguments": {
        "point": "living_room_entry_a"
          },
          "arrival": {
            "scope": "point",
        "display_name": "客厅找狗位置",
            "position_tolerance_m": 0.4,
            "skip_if_satisfied": true
          },
          "depends_on": [],
          "silent_result": true
        },
        {
          "id": "search",
          "skill": "pet_tracking",
          "action": "find",
          "arguments": {
            "pet": "dog",
            "duration": {
              "$arg": "duration",
              "default": 20
            }
          },
          "depends_on": [
            "navigate"
