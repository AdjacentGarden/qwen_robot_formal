  "procedures": {
    "living_room_light_service": {
      "description": "客厅灯光服务。普通表达打开客厅灯时，开灯与导航到客厅A点并行；到达后使用前摄观察灯光是否亮起。Token过期、设备离线、网络或接口失败只影响灯控结果，不得阻断导航与现场观察。只有用户明确要求只远程开灯或不用过去时，才改用原子 light_control.on。",
      "semantic_examples": [
        "天黑了，帮我打开客厅的灯",
        "客厅太暗了",
        "去客厅帮我开灯",
        "把客厅照亮"
      ],
      "parameters": {},
      "effects": [
        "living_room_light=on",
        "robot_room=living_room",
        "living_room_lighting_observed=true"
      ],
      "composition_rules": [
        "本能力可作为多指令中的一个节点。",
        "开灯和导航没有资源冲突，必须并行。",
        "若前面有明确任务，则两项根步骤都依赖前一个任务。",
        "灯控失败不得取消或跳过导航；导航成功后仍必须继续观察现场灯光。",
        "灯控失败原因必须来自技能结构化结果，区分凭证过期或无效、设备离线、服务超时、网络不可达和其他控制失败。",
        "不要分别播报开灯、导航和观察结果，只播报一次真实组合结果。"
      ],
      "steps": [
        {
          "id": "light",
          "skill": "light_control",
          "action": "on",
          "arguments": {},
          "depends_on": [],
          "silent_result": true
        },
        {
          "id": "navigate",
          "skill": "navigation_goto",
          "action": "goto",
          "arguments": {
            "point": "living_room_entry_a"
          },
          "arrival": {
            "scope": "room",
            "room": "living_room",
            "display_name": "客厅",
            "skip_if_satisfied": true
          },
          "depends_on": [],
          "silent_result": true
        },
        {
          "id": "inspect_light",
          "skill": "environment_perception",
          "action": "inspect",
          "arguments": {
            "purpose": "lighting",
            "camera": "front",
            "timeout": 12
          },
          "depends_on": [
            "navigate"
          ],
          "silent_result": true
        }
      ],
      "outcomes": [
        {
          "name": "already_in_room_success",
          "when": {
            "all_ok": [
              "light",
              "navigate",
              "inspect_light"
            ],
            "field": {
              "step": "navigate",
              "path": "already_satisfied",
              "equals": true
            }
          },
          "text": "我已经在客厅了，客厅的灯也已经打开了。"
        },
        {
          "name": "auth_failed_navigation_completed",
          "when": {
            "all_ok": ["navigate"],
            "any_failed": ["light"],
            "field": {
              "step": "light",
              "path": "failure_reason",
              "equals": "auth_expired_or_invalid"
            }
          },
          "text": "我已经到客厅了，不过灯光控制凭证已经过期或无效，所以没有成功打开灯。"
        },
        {
          "name": "device_offline_navigation_completed",
          "when": {
            "all_ok": ["navigate"],
            "any_failed": ["light"],
            "field": {
              "step": "light",
              "path": "failure_reason",
              "equals": "device_offline"
            }
          },
          "text": "我已经到客厅了，不过灯具当前离线，所以没有成功打开灯。"
        },
        {
          "name": "service_timeout_navigation_completed",
          "when": {
            "all_ok": ["navigate"],
            "any_failed": ["light"],
            "field": {
              "step": "light",
              "path": "failure_reason",
              "equals": "service_timeout"
            }
          },
          "text": "我已经到客厅了，不过连接灯光服务超时，所以没有成功打开灯。"
        },
        {
          "name": "network_unavailable_navigation_completed",
          "when": {
            "all_ok": ["navigate"],
            "any_failed": ["light"],
            "field": {
              "step": "light",
              "path": "failure_reason",
              "equals": "network_unavailable"
            }
          },
          "text": "我已经到客厅了，不过当前网络无法连接灯光服务，所以没有成功打开灯。"
        },
        {
          "name": "already_in_room_light_failed",
          "when": {
            "any_failed": [
              "light"
            ],
            "field": {
              "step": "navigate",
              "path": "already_satisfied",
              "equals": true
            }
          },
          "text": "我已经在客厅了，不过客厅灯刚才没有成功打开。"
        },
        {
          "name": "all_success",
          "when": {
            "all_ok": [
              "light",
              "navigate",
              "inspect_light"
            ]
          },
          "text": "已经为你打开客厅的灯了。"
        },
        {
          "name": "light_on_observation_failed",
          "when": {
            "all_ok": ["light", "navigate"],
            "any_failed": ["inspect_light"]
          },
          "text": "客厅灯控制已经成功，我也到客厅了，不过刚才没有看清现场灯光。"
        },
        {
          "name": "light_only",
          "when": {
            "all_ok": [
              "light"
            ],
            "any_failed": [
              "navigate"
            ]
          },
          "text": "客厅的灯已经打开了，不过我刚才没能顺利到达客厅。"
        },
        {
          "name": "navigation_only",
          "when": {
            "all_ok": [
              "navigate"
            ],
            "any_failed": [
              "light"
            ]
          },
          "text": "我已经到客厅并检查了现场，不过客厅灯刚才没有成功打开。"
        },
        {
          "name": "all_failed",
          "when": {
            "any_failed": [
              "light",
              "navigate"
            ]
          },
          "text": "客厅灯目前离线，而且我刚才也没能顺利到达客厅。"
        }
      ]
    },
    "push_up_companion": {
    "description": "陪主人做俯卧撑。先导航到已标定白墙点并抬头，使用后摄像头确认张三身份；身份确认成功后由前方投影设备播放运动视频并给出准备播报，随后继续使用后摄像头进行持续ReID和俯卧撑计数；结束后关闭投影并恢复平视。",
      "semantic_examples": [
        "来陪我一起做运动吧",
        "陪我做俯卧撑",
        "帮我数俯卧撑",
        "我们开始锻炼吧"
      ],
      "parameters": {
        "name": {
          "type": "str",
          "default": "zhangsan"
        },
        "duration": {
          "type": "float",
          "optional": true
        }
      },
    "effects": [
      "robot_at=white_wall",
        "push_up_session=completed",
        "projector=off",
        "head=level"
      ],
      "composition_rules": [
        "当前演示中只说做运动而未指定类型时，默认俯卧撑。",
        "导航失败不得启动计数。",
        "身份确认和运动计数都必须使用后摄像头。",
        "只有身份确认成功后才允许启动运动投影和计数。",
        "运动中的身份、ReID、数量和总结由 push_up 真实事件负责。",
        "运动结束或失败后都必须关闭投影并恢复平视。"
      ],
      "steps": [
        {
          "id": "navigate",
          "skill": "navigation_goto",
          "action": "goto",
          "arguments": {
        "point": "white_wall"
          },
          "arrival": {
            "scope": "pose",
        "display_name": "白墙运动位置",
            "position_tolerance_m": 0.35,
            "yaw_tolerance_rad": 0.35,
            "skip_if_satisfied": true
          },
          "depends_on": [],
          "silent_result": true
        },
        {
          "id": "prepare_view",
          "skill": "head_control",
          "action": "up",
          "arguments": {},
          "depends_on": [
            "navigate"
          ],
          "silent_result": true
        },
        {
          "id": "count",
          "skill": "push_up",
          "action": "run",
          "arguments": {
            "name": {
              "$arg": "name",
              "default": "zhangsan"
            },
            "duration": {
              "$arg": "duration",
              "default": 30
            },
            "identity_camera": "/dev/video31",
            "camera": "/dev/video31",
            "projector_after_identity": true,
            "preparation_delay": 4.0
          },
          "depends_on": [
            "prepare_view"
          ],
          "silent_result": false
        },
        {
          "id": "projector_off",
          "skill": "projector_control",
          "action": "off",
          "arguments": {},
          "depends_on": [
            "count"
          ],
          "dependency_policy": "completion",
          "run_if": {
            "field": {
              "step": "count",
              "path": "skipped",
              "truthy": false
            }
          },
          "silent_result": true
        },
        {
          "id": "level",
          "skill": "head_control",
          "action": "level",
          "arguments": {},
          "depends_on": [
            "projector_off"
          ],
          "dependency_policy": "completion",
          "run_if": {
            "any_failed": [
              "projector_off"
            ]
          },
          "silent_result": true
        }
      ],
      "outcomes": [
        {
          "name": "navigation_failed",
          "when": {
            "any_executed_failed": [
              "navigate"
            ]
          },
          "text": "我刚才没能到达运动位置，所以还没有开始计数。"
        },
        {
          "name": "preparation_failed",
          "when": {
            "any_executed_failed": [
              "prepare_view"
            ]
          },
          "text": "运动前的视角准备没有完成，所以还没有开始身份确认。"
        },
        {
          "name": "count_failed",
          "when": {
            "any_executed_failed": [
              "count"
            ]
          },
          "text": "这次身份确认或运动计数没有正常完成，请重新站到后置摄像头画面中央。"
        },
        {
          "name": "projection_cleanup_failed",
          "when": {
            "any_executed_failed": [
              "projector_off"
            ]
          },
          "text": "运动已经结束，但投影关闭状态刚才没有完全确认。"
        },
        {
          "name": "restore_failed",
          "when": {
            "any_executed_failed": [
              "level"
            ]
          },
          "text": "运动流程已经结束，不过头部平视状态刚才没有确认成功。"
        }
      ]
    },
