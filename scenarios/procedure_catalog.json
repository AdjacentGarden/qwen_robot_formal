        "开始会议投影",
        "播放会议内容",
        "帮我把会议内容投出来"
      ],
      "parameters": {},
    "effects": [
      "robot_at=white_wall",
        "meeting_projection=on"
      ],
      "composition_rules": [
        "导航失败不得抬头或启动投影。",
        "当前临时屏蔽白墙视觉识别，导航和抬头成功后直接启动投影。",
        "中间步骤不逐项播报，只播报最终结果。",
        "暂停不恢复平视；关闭投影后必须恢复平视。"
      ],
      "steps": [
        {
          "id": "navigate",
          "skill": "navigation_goto",
          "action": "goto",
          "arguments": {
        "point": "white_wall"
          },
          "arrival": {
            "scope": "pose",
        "display_name": "白墙投影位置",
            "position_tolerance_m": 0.3,
            "yaw_tolerance_rad": 0.3,
