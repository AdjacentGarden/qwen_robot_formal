        },
        {
          "name": "not_found",
          "when": {
            "all_ok": [
              "search"
            ],
            "field": {
              "step": "search",
              "path": "found",
              "equals": false
            }
          },
          "text": "我在这里找了一圈，暂时没有看到豆豆，所以没有启动投喂。"
        },
        {
          "name": "navigation_failed",
          "when": {
            "any_failed": [
              "navigate"
            ]
          },
          "text": "我刚才没能到达豆豆附近，所以没有开始寻找和投喂。"
        },
        {
          "name": "search_failed",
          "when": {
