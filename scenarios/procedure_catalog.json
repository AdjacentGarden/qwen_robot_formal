              "default": 10
            }
          },
          "depends_on": [
            "search"
          ],
          "run_if": {
            "field": {
              "step": "search",
              "path": "found",
              "equals": true
            }
          },
          "silent_result": true
        }
      ],
      "outcomes": [
        {
          "name": "found_and_fed",
          "when": {
            "all_ok": [
              "search",
              "feed"
            ],
            "field": {
              "step": "search",
              "path": "found",
              "equals": true
            }
          },
      "text": "豆豆找到了，五秒视频正在同步到手机，也已经开始给它喂食了。"
        },
        {"name": "feed_auth_failed_after_video", "when": {"any_failed": ["feed"], "field": {"step": "feed", "path": "failure_reason", "equals": "auth_expired_or_invalid"}}, "text": "豆豆找到了，五秒视频也已经同步到手机，不过投食机控制凭证已经过期或无效，所以没有投喂。"},
        {"name": "feed_device_offline_after_video", "when": {"any_failed": ["feed"], "field": {"step": "feed", "path": "failure_reason", "equals": "device_offline"}}, "text": "豆豆找到了，五秒视频也已经同步到手机，不过投食机当前离线，所以没有投喂。"},
        {"name": "feed_timeout_after_video", "when": {"any_failed": ["feed"], "field": {"step": "feed", "path": "failure_reason", "equals": "service_timeout"}}, "text": "豆豆找到了，五秒视频也已经同步到手机，不过连接投食机服务超时，所以没有投喂。"},
        {"name": "feed_network_failed_after_video", "when": {"any_failed": ["feed"], "field": {"step": "feed", "path": "failure_reason", "equals": "network_unavailable"}}, "text": "豆豆找到了，五秒视频也已经同步到手机，不过当前网络无法连接投食机服务，所以没有投喂。"},
        {
          "name": "found_feed_failed",
          "when": {
            "any_failed": [
              "feed"
            ],
            "field": {
              "step": "search",
              "path": "found",
              "equals": true
            }
          },
