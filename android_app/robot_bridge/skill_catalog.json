{
  "version": 1,
  "skills": {
    "autonomous_projection": {
      "description": "自主寻找适合会议投影的墙面。它从实时地图提取物理墙，每面墙仅保留一个主候选点；优先取墙面几何中心沿法线向外2米并朝向墙中心的位置，中心不可达时才允许沿墙方向退让不超过0.60米。逐墙导航、调整头部并检查预计投影区域；全部检查通过后才开启投影。普通的开始会议投影必须使用 meeting_projection 过程，不得直接调用 projector_control 开启。",
      "actions": {
        "search_and_project": {
          "argv": ["search_and_project"],
          "success_speech": "已经找到合适的位置并开始投影了。",
          "failure_speech": "我检查了可达的墙面，但这次没有找到合适的投影位置。",
          "completion_mode": "background",
          "completion_timeout_sec": 900
        },
        "plan": {"argv": ["plan"], "success_speech": "投影搜索路线已经规划好了。", "failure_speech": "暂时没有规划出可用的投影搜索路线。"},
        "stop": {"argv": ["stop"], "success_speech": "已经停止寻找投影位置。", "failure_speech": "没有成功停止投影搜索。"}
      },
      "arguments": {
        "map_yaml": {"flag": "--map-yaml", "type": "str"},
        "start_x": {"flag": "--start-x", "type": "float"},
        "start_y": {"flag": "--start-y", "type": "float"},
        "max_candidates": {"flag": "--max-candidates", "type": "int"},
        "judge": {"flag": "--judge", "type": "str", "choices": ["auto", "local", "vlm"]},
        "dry_run": {"flag": "--dry-run", "type": "bool"}
      },
      "auto_argv": ["--json"],
      "stop_action": "stop"
    },
    "pet_map_search": {
      "description": "矩形分区寻找豆豆：把可达地图自动划分为不超过6个的少量矩形区域；大房间继续拆分，确保中心到最远角点不超过约2.4米的可靠检测距离。按当前位置就近排序，依次导航到每个安全中心并完整旋转检测。找到后立即停止底盘、不跟随，使用常驻前摄像头录制5秒视频并生成手机上传任务，之后才返回完成；只有所有矩形中心均成功扫描后才报告没找到。普通找狗或找豆豆必须选择 find_pet 过程，不得用固定导航点代替。",
      "actions": {
        "search": {
          "argv": ["search"],
          "success_speech": "地图搜索已经完成。",
          "failure_speech": "这次地图搜索没有完整完成。",
          "completion_mode": "background",
          "completion_timeout_sec": 1200
        },
        "plan": {"argv": ["plan"], "success_speech": "找豆豆的矩形分区路线已经规划好了。", "failure_speech": "暂时没有规划出完整的搜索路线。"},
        "stop": {"argv": ["stop"], "success_speech": "已经停止寻找豆豆。", "failure_speech": "没有成功停止搜索。"}
      },
      "arguments": {
        "pet": {"flag": "--pet", "type": "str", "choices": ["dog", "cat"]},
        "map_yaml": {"flag": "--map-yaml", "type": "str"},
        "start_x": {"flag": "--start-x", "type": "float"},
        "start_y": {"flag": "--start-y", "type": "float"},
        "max_regions": {"flag": "--max-regions", "type": "int"},
        "dry_run": {"flag": "--dry-run", "type": "bool"}
      },
      "auto_argv": ["--json"],
      "stop_action": "stop"
    },
