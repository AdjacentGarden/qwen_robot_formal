    "face_recognition": {
      "description": "观察指定摄像头画面，判断是否拍到完整且可识别的人脸，并在可能时识别身份。选择本技能后必须按照 planning_guidance 安排观察视角、识别和清理动作。",
      "planning_guidance": {
        "selection_semantics": "用户询问面前、眼前、前方或镜头中的人是谁，要求看看、认一下或确认人物身份，以及语义相同或近似的表达，都应选择本技能。",
        "required_sequence_when_selected": [
          {
            "id_hint": "raise_view",
            "skill": "head_control",
            "action": "up",
            "arguments": {},
            "silent_result": true,
            "reason": "识别人脸前先把头部调整到更容易拍到完整人脸的观察角度。"
          },
          {
            "id_hint": "recognize_face",
            "skill": "face_recognition",
            "action": "recognize",
            "arguments": {"camera": "front"},
            "depends_on_previous": true,
            "reason": "头部到位后再使用前置摄像头识别人脸。"
          },
          {
            "id_hint": "restore_view",
            "skill": "head_control",
            "action": "level",
            "arguments": {},
            "depends_on_previous": true,
            "dependency_policy": "completion",
            "silent_result": true,
            "reason": "无论识别成功、没有拍到完整人脸还是识别失败，最后都恢复平视。"
          }
        ],
        "planning_rules": [
          "把上述三个步骤作为原子 skill goals 输出，并用 depends_on 保持顺序。",
          "最后的恢复平视步骤必须设置 dependency_policy=completion，使前一步失败时仍能执行。",
          "除非用户明确要求保持当前头部角度，否则不得省略恢复平视。"
        ],
        "result_semantics": {
          "matched": "明确播报识别出的中文姓名。",
          "unknown": "说明拍到了人脸，但暂时不认识这个人。",
          "uncertain": "说明可能的身份，但明确表达不能确定。",
          "no_face": "只说明没有拍到可识别的完整人脸，不能据此断言画面里没有人。",
          "insufficient_face_samples": "说明拍到了人脸，但画面还不够清晰完整。",
          "error": "说明本次人脸识别没有成功完成。"
        }
      },
      "actions": {
        "recognize": {
          "argv": [],
          "success_speech": "人脸识别已经完成。",
          "failure_speech": "刚才没有成功完成人脸识别。",
          "completion_mode": "foreground",
          "completion_timeout_sec": 25,
          "outcome_speech": [
            {
              "when": {"path": "status", "equals": "matched"},
              "text": "面前的是{name}。",
              "value_maps": {"name": {"zhangsan": "张三"}}
            },
            {
              "when": {"path": "status", "equals": "unknown"},
              "text": "我拍到了人脸，但暂时不认识这个人。"
            },
            {
              "when": {"path": "status", "equals": "uncertain"},
              "text": "看起来可能是{name}，但我还不能确定。",
              "value_maps": {"name": {"zhangsan": "张三"}},
              "defaults": {"name": "这个人"}
            },
            {
              "when": {"path": "status", "equals": "no_face"},
              "text": "我没有拍到可以识别的完整人脸。"
            },
            {
              "when": {"path": "status", "equals": "insufficient_face_samples"},
              "text": "我拍到了人脸，但画面还不够清晰完整。"
            },
            {
              "when": {"path": "status", "equals": "error"},
              "text": "刚才没有成功完成人脸识别。"
            }
          ]
        }
      },
      "arguments": {
        "camera": {"flag": "--camera", "type": "str"}
      }
    },
