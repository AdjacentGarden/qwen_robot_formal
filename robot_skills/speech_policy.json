{
  "version": 1,
  "owner": "/home/test/new_project",
  "transport": "stdout",
  "environment": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONIOENCODING": "utf-8",
    "SINGLE_FUNCTION_JSON": "1",
    "SINGLE_FUNCTION_SPEECH_EVENTS": "1"
  },
  "rules": {
    "fitness": {
      "skills": ["squat", "push_up", "pull_up"],
