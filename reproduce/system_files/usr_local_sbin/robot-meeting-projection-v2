#!/usr/bin/env bash
set -euo pipefail

readonly ACTION="${1:-check}"
readonly CONTAINER="android_0"
readonly VIDEO_PACKAGE="android.rk.RockVideoPlayer"
readonly GALLERY_PACKAGE="com.android.gallery3d"
readonly VIEWER_PACKAGE="com.adjacentgarden.meeting"
readonly VIEWER_ACTIVITY="com.adjacentgarden.meeting/.MeetingSlidesActivity"
readonly VIEWER_PAUSE_ACTION="com.adjacentgarden.meeting.PAUSE"
readonly VIEWER_RESUME_ACTION="com.adjacentgarden.meeting.RESUME"
readonly HOST_VIEWER_APK="/home/test/qwen_audio_3_realtime_flash_scenarios_resident_test/robot_skills/projector_control/assets/meeting-image-viewer.apk"
readonly HOST_VIEWER_DIGEST="/home/test/qwen_audio_3_realtime_flash_scenarios_resident_test/robot_skills/projector_control/assets/meeting-image-viewer.apk.sha256"
readonly CONTAINER_VIEWER_APK="/data/local/tmp/meeting-image-viewer.apk"
readonly SOURCE_SLIDE_1="/sdcard/Pictures/test-1.jpg"
readonly SOURCE_SLIDE_2="/sdcard/Pictures/test-2.jpg"
readonly SOURCE_SLIDE_1_SHA256="1a15506352fe68dffdf8e61df85703e93e27e370ada8b8db6cf46b5a7880d542"
readonly SOURCE_SLIDE_2_SHA256="84ea835ad85b415edf8e228790b9c93fe53c3f2eebba13df7d612745863c8e83"
readonly LEGACY_LOOP_PID_FILE="/data/local/tmp/qwen_meeting_image_loop.pid"
readonly PREP="/usr/local/libexec/robot-projection-prep"

viewer_expected_sha() {
  /usr/bin/awk 'NR == 1 {print $1}' "$HOST_VIEWER_DIGEST"
}

viewer_host_sha() {
  /usr/bin/sha256sum "$HOST_VIEWER_APK" | /usr/bin/awk '{print $1}'
}

viewer_installed_sha() {
  local installed_path
  installed_path="$(/usr/bin/docker exec "$CONTAINER" pm path "$VIEWER_PACKAGE" 2>/dev/null | /usr/bin/head -n 1 | /usr/bin/cut -d: -f2)"
  [[ -n "$installed_path" ]] || return 0
  /usr/bin/docker exec "$CONTAINER" sha256sum "$installed_path" 2>/dev/null | /usr/bin/awk '{print $1}'
}

verify_meeting_media() {
  local actual_1 actual_2
  actual_1="$(/usr/bin/docker exec "$CONTAINER" sha256sum "$SOURCE_SLIDE_1" | /usr/bin/awk '{print $1}')"
  actual_2="$(/usr/bin/docker exec "$CONTAINER" sha256sum "$SOURCE_SLIDE_2" | /usr/bin/awk '{print $1}')"
  [[ "$actual_1" == "$SOURCE_SLIDE_1_SHA256" ]] || {
    echo "meeting slide 1 checksum mismatch" >&2
    return 1
  }
  [[ "$actual_2" == "$SOURCE_SLIDE_2_SHA256" ]] || {
    echo "meeting slide 2 checksum mismatch" >&2
    return 1
  }
}

prepare_viewer() {
  test -s "$HOST_VIEWER_APK"
  test -s "$HOST_VIEWER_DIGEST"
  local expected actual_host actual_installed
  expected="$(viewer_expected_sha)"
  actual_host="$(viewer_host_sha)"
  [[ "$actual_host" == "$expected" ]] || {
    echo "meeting viewer checksum mismatch" >&2
    return 1
  }
  actual_installed="$(viewer_installed_sha || true)"
  if [[ "$actual_installed" != "$expected" ]]; then
    /usr/bin/docker cp "$HOST_VIEWER_APK" "$CONTAINER:$CONTAINER_VIEWER_APK"
    /usr/bin/docker exec "$CONTAINER" pm install -r "$CONTAINER_VIEWER_APK" >/dev/null
    /usr/bin/docker exec "$CONTAINER" rm -f "$CONTAINER_VIEWER_APK"
  fi
  actual_installed="$(viewer_installed_sha || true)"
  [[ "$actual_installed" == "$expected" ]] || {
    echo "meeting viewer install verification failed" >&2
    return 1
  }
}

prepare_display() {
  local pid
  pid="$(/usr/bin/pidof surfaceflinger | /usr/bin/awk '{print $1}')"
  [[ -n "$pid" ]] || { echo "surfaceflinger pid not found" >&2; return 1; }
  /usr/bin/nsenter -t "$pid" -m -p -- /system/bin/settings put system accelerometer_rotation 0
  /usr/bin/nsenter -t "$pid" -m -p -- /system/bin/settings put system user_rotation 2
  /usr/bin/nsenter -t "$pid" -m -p -- /system/bin/cmd window user-rotation lock 2
  /usr/bin/nsenter -t "$pid" -m -p -- /system/bin/cmd window fixed-to-user-rotation enabled
  /usr/bin/nsenter -t "$pid" -m -p -- /system/bin/cmd window set-ignore-orientation-request true
  [[ ! -x "$PREP" ]] || "$PREP"
  /usr/bin/docker exec "$CONTAINER" /system/bin/settings put global policy_control 'immersive.full=*'
}

meeting_pid() {
  /usr/bin/docker exec "$CONTAINER" pidof "$VIEWER_PACKAGE" 2>/dev/null | /usr/bin/awk '{print $1}'
}

meeting_running() {
  [[ -n "$(meeting_pid || true)" ]]
}

wait_for_state() {
  local expected="$1"
  local attempt
  for attempt in $(seq 1 60); do
    if meeting_running; then
      [[ "$expected" == "running" ]] && return 0
    else
      [[ "$expected" == "stopped" ]] && return 0
    fi
    sleep 0.05
  done
  return 1
}

stop_legacy_loop() {
  /usr/bin/docker exec "$CONTAINER" sh -c "
    if test -s '$LEGACY_LOOP_PID_FILE'; then
      legacy_pid=\$(cat '$LEGACY_LOOP_PID_FILE')
      kill -CONT \"\$legacy_pid\" 2>/dev/null || true
      kill -KILL \"\$legacy_pid\" 2>/dev/null || true
    fi
    # A formerly paused loop can lose its PID file while its parent/child
    # shells remain alive.  Find both by command signature, resume them so
    # a legacy TERM trap only removed its PID file and resumed the loop, so
    # force-stop these exact obsolete loop processes before the new viewer.
    for legacy_pid in \$(ps -A -o PID,ARGS | awk '/[q]wen_meeting_image_loop[.]sh/{print \$1}'); do
      kill -CONT \"\$legacy_pid\" 2>/dev/null || true
      kill -KILL \"\$legacy_pid\" 2>/dev/null || true
    done
    rm -f '$LEGACY_LOOP_PID_FILE'
  "
}

case "$ACTION" in
  check)
    /usr/bin/docker inspect "$CONTAINER" >/dev/null
    [[ -x "$PREP" ]] || { echo "projection prep is unavailable" >&2; exit 1; }
    verify_meeting_media
    prepare_viewer
    echo "Seamless fullscreen meeting projection is ready"
    ;;
  loop-start)
    verify_meeting_media
    prepare_viewer
    prepare_display
    stop_legacy_loop
    /usr/bin/docker exec "$CONTAINER" sh -c \
      "am force-stop '$VIDEO_PACKAGE' >/dev/null 2>&1 || true; am force-stop '$GALLERY_PACKAGE' >/dev/null 2>&1 || true; am force-stop '$VIEWER_PACKAGE' >/dev/null 2>&1 || true; am start -S -n '$VIEWER_ACTIVITY' >/dev/null"
    wait_for_state running || { echo "meeting image viewer did not start" >&2; exit 1; }
    ;;
  loop-stop)
    stop_legacy_loop
    /usr/bin/docker exec "$CONTAINER" am force-stop "$VIDEO_PACKAGE" >/dev/null 2>&1 || true
    /usr/bin/docker exec "$CONTAINER" am force-stop "$VIEWER_PACKAGE" >/dev/null 2>&1 || true
    /usr/bin/docker exec "$CONTAINER" am force-stop "$GALLERY_PACKAGE" >/dev/null 2>&1 || true
    wait_for_state stopped || { echo "meeting image viewer did not stop" >&2; exit 1; }
    ;;
  loop-pause)
    meeting_running || { echo "meeting image viewer is not running" >&2; exit 1; }
    /usr/bin/docker exec "$CONTAINER" am broadcast -a "$VIEWER_PAUSE_ACTION" -p "$VIEWER_PACKAGE" >/dev/null
    ;;
  loop-resume)
    meeting_running || { echo "meeting image viewer is not running" >&2; exit 1; }
    /usr/bin/docker exec "$CONTAINER" am broadcast -a "$VIEWER_RESUME_ACTION" -p "$VIEWER_PACKAGE" >/dev/null
    ;;
  loop-status)
    if meeting_running; then
      echo "running"
    else
      echo "stopped"
      exit 1
    fi
    ;;
  *)
    echo "usage: $0 {check|loop-start|loop-stop|loop-pause|loop-resume|loop-status}" >&2
    exit 2
    ;;
esac
