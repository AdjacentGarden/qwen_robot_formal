#!/usr/bin/env bash
set -euo pipefail

readonly CONTAINER="android_0"
readonly HOST_IMAGE="/home/test/qwen_audio_3_realtime_flash_scenarios_resident_test/robot_skills/welcome_projection/assets/welcome_home.png"
readonly HOST_DIGEST="/home/test/qwen_audio_3_realtime_flash_scenarios_resident_test/robot_skills/welcome_projection/assets/welcome_home.png.sha256"
readonly HOST_VIEWER_APK="/home/test/qwen_audio_3_realtime_flash_scenarios_resident_test/robot_skills/welcome_projection/assets/welcome-image-viewer.apk"
readonly HOST_VIEWER_DIGEST="/home/test/qwen_audio_3_realtime_flash_scenarios_resident_test/robot_skills/welcome_projection/assets/welcome-image-viewer.apk.sha256"
readonly IMAGE="/sdcard/Pictures/welcome_home.png"
readonly STORAGE_IMAGE="/data/media/0/Pictures/welcome_home.png"
readonly VIEWER_APK="/data/local/tmp/welcome-image-viewer.apk"
readonly VIEWER_PACKAGE="com.adjacentgarden.welcome"
readonly VIEWER_ACTIVITY="com.adjacentgarden.welcome/.WelcomeImageActivity"
readonly GALLERY_PACKAGE="com.android.gallery3d"
readonly VIDEO_PACKAGE="android.rk.RockVideoPlayer"

expected_sha() {
  /usr/bin/awk 'NR == 1 {print $1}' "$HOST_DIGEST"
}

host_sha() {
  /usr/bin/sha256sum "$HOST_IMAGE" | /usr/bin/awk '{print $1}'
}

container_sha() {
  /usr/bin/docker exec "$CONTAINER" sha256sum "$IMAGE" 2>/dev/null | /usr/bin/awk '{print $1}'
}

viewer_expected_sha() {
  /usr/bin/awk 'NR == 1 {print $1}' "$HOST_VIEWER_DIGEST"
}

viewer_host_sha() {
  /usr/bin/sha256sum "$HOST_VIEWER_APK" | /usr/bin/awk '{print $1}'
}

viewer_installed_sha() {
  local installed_path
  installed_path="$(/usr/bin/docker exec "$CONTAINER" pm path "$VIEWER_PACKAGE" 2>/dev/null | /usr/bin/head -n 1 | /usr/bin/cut -d: -f2)"
  [[ -n "$installed_path" ]] || return 0
  /usr/bin/docker exec "$CONTAINER" sha256sum "$installed_path" 2>/dev/null | /usr/bin/awk '{print $1}'
}

prepare_viewer() {
  test -s "$HOST_VIEWER_APK"
  test -s "$HOST_VIEWER_DIGEST"
  local expected actual_host actual_installed
  expected="$(viewer_expected_sha)"
  actual_host="$(viewer_host_sha)"
  [[ "$actual_host" == "$expected" ]] || { echo "welcome viewer checksum mismatch" >&2; exit 1; }
  actual_installed="$(viewer_installed_sha || true)"
  if [[ "$actual_installed" != "$expected" ]]; then
    /usr/bin/docker cp "$HOST_VIEWER_APK" "$CONTAINER:$VIEWER_APK"
    /usr/bin/docker exec "$CONTAINER" pm install -r "$VIEWER_APK" >/dev/null
    /usr/bin/docker exec "$CONTAINER" rm -f "$VIEWER_APK"
  fi
  actual_installed="$(viewer_installed_sha || true)"
  [[ "$actual_installed" == "$expected" ]] || { echo "welcome viewer install verification failed" >&2; exit 1; }
}

prepare_media() {
  test -s "$HOST_IMAGE"
  test -s "$HOST_DIGEST"
  local expected actual_host actual_container
  expected="$(expected_sha)"
  actual_host="$(host_sha)"
  [[ "$actual_host" == "$expected" ]] || { echo "welcome source checksum mismatch" >&2; exit 1; }
  /usr/bin/docker exec "$CONTAINER" mkdir -p /data/media/0/Pictures
  actual_container="$(container_sha || true)"
  if [[ "$actual_container" != "$expected" ]]; then
    /usr/bin/docker cp "$HOST_IMAGE" "$CONTAINER:$STORAGE_IMAGE.codex-new"
    /usr/bin/docker exec "$CONTAINER" mv "$STORAGE_IMAGE.codex-new" "$STORAGE_IMAGE"
  fi
  actual_container="$(container_sha || true)"
  [[ "$actual_container" == "$expected" ]] || { echo "welcome container checksum mismatch after copy" >&2; exit 1; }
  prepare_viewer
}

verify_media() {
  test -s "$HOST_IMAGE"
  test -s "$HOST_DIGEST"
  local expected actual_host actual_container
  expected="$(expected_sha)"
  actual_host="$(host_sha)"
  actual_container="$(container_sha || true)"
  [[ "$actual_host" == "$expected" ]] || { echo "welcome source checksum mismatch" >&2; exit 1; }
  [[ "$actual_container" == "$expected" ]] || { echo "welcome container checksum mismatch" >&2; exit 1; }
  prepare_viewer
  echo "welcome projection image is ready"
}

case "${1:-status}" in
  verify) verify_media ;;
  prepare) prepare_media ;;
  start)
    prepare_media
    pid="$(/usr/bin/pidof surfaceflinger | /usr/bin/awk '{print $1}')"
    test -n "$pid"
    /usr/bin/nsenter -t "$pid" -m -p -- /system/bin/settings put system accelerometer_rotation 0
    /usr/bin/nsenter -t "$pid" -m -p -- /system/bin/settings put system user_rotation 2
    /usr/bin/nsenter -t "$pid" -m -p -- /system/bin/cmd window user-rotation lock 2
    /usr/bin/nsenter -t "$pid" -m -p -- /system/bin/cmd window fixed-to-user-rotation enabled
    /usr/bin/nsenter -t "$pid" -m -p -- /system/bin/cmd window set-ignore-orientation-request true
    /usr/local/libexec/robot-projection-prep
    /usr/bin/docker exec "$CONTAINER" /system/bin/settings put global policy_control 'immersive.full=*'
    /usr/bin/docker exec "$CONTAINER" sh -c "am force-stop $VIDEO_PACKAGE >/dev/null 2>&1 || true; am force-stop $GALLERY_PACKAGE >/dev/null 2>&1 || true; am force-stop $VIEWER_PACKAGE >/dev/null 2>&1 || true; am start -S -n $VIEWER_ACTIVITY"
    ;;
  stop) /usr/bin/docker exec "$CONTAINER" am force-stop "$VIEWER_PACKAGE" >/dev/null 2>&1 || true ;;
  status) /usr/bin/docker exec "$CONTAINER" pidof "$VIEWER_PACKAGE" >/dev/null 2>&1 ;;
  *) echo "usage: $0 {verify|prepare|start|stop|status}" >&2; exit 2 ;;
esac
