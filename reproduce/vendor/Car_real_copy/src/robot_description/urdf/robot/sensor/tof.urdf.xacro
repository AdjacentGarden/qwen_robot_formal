<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find robot_description)/urdf/robot/common_inertia.xacro" />
  <xacro:macro name="tof_xacro" params="body_radius mode:=high_precision">
    <!-- ============ TOF400F 传感器参数 (根据手册) ============ -->
    <!-- 尺寸: 18mm x 17mm x 6.5mm -->
    <xacro:property name="tof_length" value="0.018"/>
    <xacro:property name="tof_width"  value="0.017"/>
    <xacro:property name="tof_height" value="0.0065"/>
    <xacro:property name="tof_mass"   value="0.003"/>  <!-- 3g -->

    <!-- 27° FOV = 0.471 rad -->
    <xacro:property name="fov_rad" value="0.4712389"/>
    <xacro:property name="half_fov" value="${fov_rad / 2.0}"/>

    <!-- pitch 15  0.2618 -->
    <xacro:property name="pitch_rad" value="0"/>

    <!-- 模式参数 (手册 Page 1, Page 11) -->
    <!-- 高精度模式: 30ms, 1.3m, ±5% -->
    <xacro:property name="hp_update_rate" value="33.33"/>
    <xacro:property name="hp_max_range"   value="1.3"/>
    <xacro:property name="hp_noise_std"   value="0.005"/>

    <!-- 远距离模式: 200ms, 4.0m, ±5%-±25% -->
    <xacro:property name="ld_update_rate" value="5.0"/>
    <xacro:property name="ld_max_range"   value="4.0"/>
    <xacro:property name="ld_noise_std"   value="0.02"/>

    <!-- 根据模式选择参数 -->
    <xacro:if value="${mode == 'high_precision'}">
      <xacro:property name="current_update_rate" value="${hp_update_rate}"/>
      <xacro:property name="current_max_range"   value="${hp_max_range}"/>
      <xacro:property name="current_noise_std"   value="${hp_noise_std}"/>
    </xacro:if>

    <xacro:unless value="${mode == 'high_precision'}">
      <xacro:property name="current_update_rate" value="${ld_update_rate}"/>
      <xacro:property name="current_max_range"   value="${ld_max_range}"/>
      <xacro:property name="current_noise_std"   value="${ld_noise_std}"/>
    </xacro:unless>

    <!-- ============ TOF400F 传感器主体 ============ -->
    <link name="tof400f_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>

        <geometry>
          <box size="${tof_length} ${tof_width} ${tof_height}"/>
        </geometry>

        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>

      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${tof_length} ${tof_width} ${tof_height}"/>
        </geometry>
      </collision>

      <xacro:box_inertia m="${tof_mass}" w="${tof_length}" h="${tof_width}" d="${tof_height}"/>
    </link>

    <joint name="tof400f_joint" type="fixed">
      <parent link="base_link"/>
      <child link="tof400f_link"/>
      <!-- 传感器突出安装支架前侧 -->
      <origin xyz="${0.01 + body_radius} 0 0" rpy="0 0 0"/>
    </joint>


    <gazebo reference="tof400f_link">
      <material>Gazebo/Black</material>

      <sensor name="tof400f_sensor" type="ray">
        
        <plugin name="tof400f_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=tof_cloud</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>tof400f_link</frame_name>
        </plugin>

        <always_on>true</always_on>
        <visualize>true</visualize>  
        <update_rate>${current_update_rate}</update_rate>
        <!-- <pose>0 0 0 0 -0.2618 0</pose> -->

        <ray>
          <scan>
            <horizontal>
              <samples>5</samples>
              <min_angle>${-half_fov}</min_angle>
              <max_angle>${half_fov}</max_angle>
            </horizontal>
            <vertical>
              <samples>5</samples>
              <min_angle>${-half_fov + pitch_rad}</min_angle>
              <max_angle>${half_fov + pitch_rad}</max_angle>
            </vertical>
          </scan>

          <range>
            <min>${tof_length/2.0 + 0.005}</min>                 
            <max>${current_max_range}</max>
            <resolution>0.001</resolution>   
          </range>

          
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>${current_noise_std}</stddev>
          </noise>
        </ray>

      </sensor>
    </gazebo>

   </xacro:macro>

</robot>