[Unit]
Description=Give the ROS IMU publisher exclusive ownership of ASM330LHH
After=systemd-udev-settle.service
Before=docker.service graphical.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/robot-imu/imu_exclusive_control.sh acquire
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
