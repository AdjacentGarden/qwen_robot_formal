{
  "name": "pet_tracking",
  "module": "/home/test/self_program/new_self_test.py",
  "entrypoint": "/home/test/single_function/pet_tracking/run.sh",
  "certification_status": "unchecked",
  "description_zh": "Use the front camera to find and track pets. Requests such as find the dog, where is the dog, check whether the dog is here, or go to a saved point and check the dog must be treated as search-and-track tasks, not single-frame detection.",
  "allowed_actions": [
    "find",
    "track",
    "stop",
    "find_route",
    "find_and_track",
    "find_route_and_track"
  ],
  "required_slots": [],
  "optional_slots": [
    "action",
    "pet",
    "camera",
    "duration",
    "timeout",
    "search_strategy",
    "points",
    "track_after_found",
    "record_video",
    "visited_points",
    "current_point",
    "current_point_index",
    "last_search_result",
    "video_path"
  ],
  "config_defaults": {
    "action": "track",
    "pet": "dog",
    "search_strategy": "current_then_known_points",
    "track_after_found": true,
    "record_video": true,
    "track_duration": 15,
    "json_output": true
  },
  "trigger_phrases_zh": [
    "\u627e\u72d7",
    "\u627e\u5c0f\u72d7",
    "小狗不见了",
    "宠物走丢了",
    "\u5c0f\u72d7\u5728\u54ea",
    "小狗现在在哪里",
    "\u72d7\u5728\u54ea",
    "\u770b\u770b\u5c0f\u72d7\u5728\u4e0d\u5728",
    "\u53bb\u5ba2\u5385\u770b\u770b\u5c0f\u72d7\u5728\u4e0d\u5728",
    "\u8ffd\u8e2a\u5ba0\u7269"
  ],
  "slot_questions_zh": {},
  "domain_tags": [
    "tracking",
    "pet",
    "camera",
    "base",
    "long_running",
    "route_search"
  ],
  "resources": [
    "front_camera",
    "npu",
    "base",
    "navigation"
  ],
  "side_effects": [
    "moves_robot",
    "opens_camera",
    "may_record_video",
    "long_running"
  ],
  "composition_affordances": [
    "If the user names a saved navigation point, call navigation_goto first and then pet_tracking with action=find_and_track.",
    "If no point is specified, call pet_tracking with action=find_route_and_track so the executor searches current location and then saved points."
  ],
  "optional_enhancements": [
    "record_video_after_found",
    "route_search_saved_points"
  ],
  "planning_notes_zh": [
    "All find-dog and where-is-dog requests must result in tracking after the pet is found.",
    "小狗不见了、宠物走丢了、找不到小狗等陈述必须按寻找宠物处理。",
    "Do not replace a find-dog request with camera_capture or a one-shot detector.",
    "Use action=find_route_and_track when the location is unspecified.",
    "Use action=find_and_track after navigation_goto when the location is specified."
  ],
  "implementation_requirements": {
    "all_find_dog_requests_track": true,
    "default_unspecified_location_action": "find_route_and_track",
    "default_specified_location_action": "find_and_track",
    "must_record_video_after_found": true,
    "must_not_use_single_frame_detection_for_find_requests": true,
    "must_save_artifact_fields": [
      "search_points",
      "visited_points",
      "current_point_result",
      "navigation_point_results",
      "found",
      "tracking_started_at",
      "tracking_duration_ms",
      "video_path",
      "end_reason"
    ]
  },
  "recovery": {
    "resumable": true,
    "resume_strategy": "resume_with_route_state",
    "requires_scene_restore": true,
    "scene_restore_requirements": [
      "pose",
      "head",
      "front_camera",
      "base",
      "navigation",
      "npu"
    ],
    "resume_slots": [
      "visited_points",
      "current_point",
      "current_point_index",
      "found",
      "last_search_result",
      "video_path"
    ]
  }
}
